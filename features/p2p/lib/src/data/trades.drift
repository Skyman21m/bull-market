-- The rules of the trade records that the database keeps itself (schema 3, #85): see `Trades` in `p2p_tables.dart`.
import 'p2p_tables.dart';

-- The parent key of the foreign key of `trades`: a trade's robot is bound on the trade's network.
-- It adds no rule to the bindings, whose primary key (key fingerprint, robot index) is already unique.
CREATE UNIQUE INDEX IF NOT EXISTS robot_bindings_network
  ON robot_bindings (key_fingerprint, robot_index, network);

-- A trade record is never deleted.
CREATE TRIGGER IF NOT EXISTS trades_never_deleted BEFORE DELETE ON trades
BEGIN
  SELECT RAISE(ABORT, 'a trade record is kept');
END;

-- A trade record changes only by setting confirmed_at or closed_at once, and a closed record never changes.
CREATE TRIGGER IF NOT EXISTS trades_set_once BEFORE UPDATE ON trades
WHEN OLD.closed_at IS NOT NULL
  OR (OLD.confirmed_at IS NOT NULL AND NEW.confirmed_at IS NOT OLD.confirmed_at)
  OR NEW.network IS NOT OLD.network
  OR NEW.key_fingerprint IS NOT OLD.key_fingerprint
  OR NEW.robot_index IS NOT OLD.robot_index
  OR NEW.coordinator_alias IS NOT OLD.coordinator_alias
  OR NEW.coordinator_onion IS NOT OLD.coordinator_onion
  OR NEW.order_id IS NOT OLD.order_id
  OR NEW.role IS NOT OLD.role
  OR NEW.origin IS NOT OLD.origin
  OR NEW.taken_at IS NOT OLD.taken_at
BEGIN
  SELECT RAISE(ABORT, 'a trade record only gains its times');
END;
