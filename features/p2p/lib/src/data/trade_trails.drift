-- The rules of the trades' terms and trails that the database keeps itself (schema 4, #87; a maker's trail and contract, schema 8, #176): see `StoredTradeTerms` and `StoredTradeTrails` in `p2p_tables.dart`.
-- What a trigger cannot say, that the position of a trail moves only along the edges of the trade, is `TradeTrailRecord.whyNotReplace`'s, which the repository asks before every write.
import 'p2p_tables.dart';

-- One open trade per order on this device: a second pending take, or take-over, of an order whose trade is open here is refused, whatever the code, before anything leaves.
-- A trigger rather than a unique index, so that the step from schema 3 never fails: a file holding two open trades of one order (no version wrote a take before this one) keeps them, and only a new one is refused.
CREATE TRIGGER IF NOT EXISTS trades_one_open_per_order BEFORE INSERT ON trades
WHEN EXISTS (SELECT 1 FROM trades WHERE network = NEW.network AND coordinator_alias = NEW.coordinator_alias AND order_id = NEW.order_id AND closed_at IS NULL)
BEGIN
  SELECT RAISE(ABORT, 'an order has one open trade');
END;

-- The same rule for an order id written after the insert, as when a pending make is confirmed (schema 8): an order id another open trade of the network and coordinator holds is refused.
CREATE TRIGGER IF NOT EXISTS trades_one_open_per_order_update BEFORE UPDATE OF order_id ON trades
WHEN EXISTS (SELECT 1 FROM trades WHERE network = NEW.network AND coordinator_alias = NEW.coordinator_alias AND order_id = NEW.order_id AND closed_at IS NULL AND NOT (key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index))
BEGIN
  SELECT RAISE(ABORT, 'an order has one open trade');
END;

-- The terms of a trade are never deleted.
CREATE TRIGGER IF NOT EXISTS trade_terms_never_deleted BEFORE DELETE ON trade_terms
BEGIN
  SELECT RAISE(ABORT, 'the terms of a trade are kept');
END;

-- The terms of a trade are set once: any update is refused.
CREATE TRIGGER IF NOT EXISTS trade_terms_set_once BEFORE UPDATE ON trade_terms
BEGIN
  SELECT RAISE(ABORT, 'the terms of a trade are set once');
END;

-- The terms of a trade are written once: a second insert, `INSERT OR REPLACE` included (whose delete fires no trigger while recursive triggers are off), writes nothing.
CREATE TRIGGER IF NOT EXISTS trade_terms_inserted_once BEFORE INSERT ON trade_terms
WHEN EXISTS (SELECT 1 FROM trade_terms WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The terms belong to the open trade of their robot: the same order, coordinator, network and role, and a trade taken here or recovered (schema 8: a trade made here has its terms in `maker_terms`).
CREATE TRIGGER IF NOT EXISTS trade_terms_of_their_trade BEFORE INSERT ON trade_terms
WHEN NOT EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index AND network = NEW.network AND coordinator_alias = NEW.coordinator_alias AND order_id = NEW.order_id AND role = NEW.role AND origin IN ('takenHere', 'recovered') AND closed_at IS NULL)
BEGIN
  SELECT RAISE(ABORT, 'terms of no open trade');
END;

-- The trail of a trade is never deleted.
CREATE TRIGGER IF NOT EXISTS trade_trails_never_deleted BEFORE DELETE ON trade_trails
BEGIN
  SELECT RAISE(ABORT, 'the trail of a trade is kept');
END;

-- The trail of a trade is written once, then only updated: a second insert, `INSERT OR REPLACE` included, writes nothing.
CREATE TRIGGER IF NOT EXISTS trade_trails_inserted_once BEFORE INSERT ON trade_trails
WHEN EXISTS (SELECT 1 FROM trade_trails WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The trail belongs to the open trade of its robot, whose order id is known and whose terms are recorded: the same order, coordinator, network and role.
-- Since schema 8, the terms of a trade taken here or recovered are in `trade_terms`, those of a trade made here in `maker_terms`; a first trail is at the first contract, and a trail of a trade not made here never has one.
CREATE TRIGGER IF NOT EXISTS trade_trails_of_their_trade BEFORE INSERT ON trade_trails
WHEN NOT EXISTS (SELECT 1 FROM trades WHERE trades.key_fingerprint = NEW.key_fingerprint AND trades.robot_index = NEW.robot_index AND trades.network = NEW.network AND trades.coordinator_alias = NEW.coordinator_alias AND trades.order_id = NEW.order_id AND trades.role = NEW.role AND trades.closed_at IS NULL AND NEW.take = 0 AND ((trades.origin IN ('takenHere', 'recovered') AND NEW.take_deadline IS NULL AND NEW.taker_hash_id IS NULL AND NEW.taken_amount IS NULL AND EXISTS (SELECT 1 FROM trade_terms WHERE trade_terms.key_fingerprint = trades.key_fingerprint AND trade_terms.robot_index = trades.robot_index)) OR (trades.origin = 'madeHere' AND EXISTS (SELECT 1 FROM maker_terms WHERE maker_terms.key_fingerprint = trades.key_fingerprint AND maker_terms.robot_index = trades.robot_index))))
BEGIN
  SELECT RAISE(ABORT, 'a trail of no open trade');
END;

-- The trail of a closed trade is never written again: a late write leaves it as it is.
CREATE TRIGGER IF NOT EXISTS trade_trails_closed BEFORE UPDATE ON trade_trails
WHEN EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = OLD.key_fingerprint AND robot_index = OLD.robot_index AND closed_at IS NOT NULL)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The trail only moves forward: its trade never changes, the version and the read never go back, a breach is never cleared, whether the history is known never changes, a pinned payment hash is never cleared or changed, the pre-take's last read is never cleared or moved back nor its deadline cleared, and an end is never left.
-- A maker's contract only moves forward too (schema 8; design note `docs/design/phase-3-making-an-order.md` § 3.2, § 3.5): `take` never goes back and moves by one at most, only for a trade made here, from a trail at `public`, `paused`, `waitingForBoth`, `waitingForEscrow` or `waitingForPayout` that has a contract deadline, to `waitingForBoth`, `waitingForEscrow` or `waitingForPayout` with a later one, or (amended by #178 before any release) to a position from the chat on with the same deadline, a taker, no escrow, and from 6, 7 or 8 another taker: a next contract seen late, whose steps went by while the app did not read, marked so (`seen_late`) in that write and kept so while the contract lasts; never from a maker buyer's 8, from which the order never goes back to the book; the escrow hash held when `take` moves joins `earlier_escrows` in that very write, which only grows so, and an escrow hash pinned is never one of them (amended again by #178 after its security review: an escrow of an earlier contract is never taken again, whatever came in between); the contract's deadline, taker and amount taken go from NULL to a value only with `take` unchanged, change only in the write that moves `take`, never go back to NULL, and are never written for a trade not made here; the escrow's hash stays pinned within a contract, and in the write that moves `take` is cleared or replaced by another hash, never kept; the bond's hash stays pinned for the order's whole life.
CREATE TRIGGER IF NOT EXISTS trade_trails_forward BEFORE UPDATE ON trade_trails
WHEN NEW.key_fingerprint IS NOT OLD.key_fingerprint
  OR NEW.robot_index IS NOT OLD.robot_index
  OR NEW.network IS NOT OLD.network
  OR NEW.coordinator_alias IS NOT OLD.coordinator_alias
  OR NEW.order_id IS NOT OLD.order_id
  OR NEW.role IS NOT OLD.role
  OR NEW.version < OLD.version
  OR NEW.read_at < OLD.read_at
  OR NEW.breached < OLD.breached
  OR NEW.history_unknown IS NOT OLD.history_unknown
  OR (OLD.bond_hash IS NOT NULL AND NEW.bond_hash IS NOT OLD.bond_hash)
  OR (OLD.escrow_hash IS NOT NULL AND NEW.escrow_hash IS NOT OLD.escrow_hash AND NEW.take IS OLD.take)
  OR (OLD.escrow_hash IS NOT NULL AND NEW.escrow_hash IS OLD.escrow_hash AND NEW.take IS NOT OLD.take)
  OR (OLD.bond_step_seen_at IS NOT NULL AND (NEW.bond_step_seen_at IS NULL OR NEW.bond_step_seen_at < OLD.bond_step_seen_at))
  OR (OLD.bond_step_deadline IS NOT NULL AND NEW.bond_step_deadline IS NULL)
  OR (OLD.position IN ('succeeded', 'makerLostDispute', 'takerLostDispute', 'expired', 'cancelled', 'publicAgain', 'notAvailable') AND NEW.position IS NOT OLD.position)
  OR (NEW.take IS NOT OLD.take AND NOT (NEW.take IS OLD.take + 1 AND OLD.position IN ('public', 'paused', 'waitingForBoth', 'waitingForEscrow', 'waitingForPayout') AND NOT (OLD.position = 'waitingForPayout' AND OLD.role = 'buyer') AND OLD.take_deadline IS NOT NULL AND ((NEW.position IN ('waitingForBoth', 'waitingForEscrow', 'waitingForPayout') AND NEW.take_deadline IS NOT NULL AND NEW.take_deadline > OLD.take_deadline AND NEW.seen_late = 0) OR (NEW.position IN ('chatting', 'fiatSent', 'inDispute', 'sendingSats', 'succeeded', 'routingFailed', 'waitingDisputeResolution', 'makerLostDispute', 'takerLostDispute') AND NEW.take_deadline IS OLD.take_deadline AND NEW.taker_hash_id IS NOT NULL AND NEW.escrow_hash IS NULL AND (OLD.position IN ('public', 'paused') OR NEW.taker_hash_id IS NOT OLD.taker_hash_id) AND NEW.seen_late = 1)) AND NEW.earlier_escrows IS (OLD.earlier_escrows || coalesce(OLD.escrow_hash || ';', '')) AND EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = OLD.key_fingerprint AND robot_index = OLD.robot_index AND origin = 'madeHere')))
  OR (NEW.take IS OLD.take AND (NEW.earlier_escrows IS NOT OLD.earlier_escrows OR NEW.seen_late IS NOT OLD.seen_late))
  OR (NEW.escrow_hash IS NOT NULL AND instr(';' || NEW.earlier_escrows, ';' || NEW.escrow_hash || ';') > 0)
  OR (OLD.take_deadline IS NOT NULL AND NEW.take_deadline IS NULL)
  OR (OLD.taker_hash_id IS NOT NULL AND NEW.taker_hash_id IS NULL)
  OR (OLD.taken_amount IS NOT NULL AND NEW.taken_amount IS NULL)
  OR (NEW.take IS OLD.take AND OLD.take_deadline IS NOT NULL AND NEW.take_deadline IS NOT OLD.take_deadline)
  OR (NEW.take IS OLD.take AND OLD.taker_hash_id IS NOT NULL AND NEW.taker_hash_id IS NOT OLD.taker_hash_id)
  OR (NEW.take IS OLD.take AND OLD.taken_amount IS NOT NULL AND NEW.taken_amount IS NOT OLD.taken_amount)
  OR (NEW.take IS NOT OLD.take AND OLD.taker_hash_id IS NULL AND NEW.taker_hash_id IS NOT NULL)
  OR (NEW.take IS NOT OLD.take AND OLD.taken_amount IS NULL AND NEW.taken_amount IS NOT NULL)
  OR ((NEW.take_deadline IS NOT NULL OR NEW.taker_hash_id IS NOT NULL OR NEW.taken_amount IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = OLD.key_fingerprint AND robot_index = OLD.robot_index AND origin = 'madeHere'))
BEGIN
  SELECT RAISE(ABORT, 'a trail only moves forward');
END;

-- The trace of terms shown otherwise (schema 9, #231; design note `docs/design/phase-3-making-an-order.md` § 3.5 bis): its time set once, in the write of the read that first showed this trade with other terms than its own (its time that read's), then never changed nor cleared; the lowest and the highest premium reads showed otherwise, written as soon as one differs, even after another term changed first, then the lowest only going down and the highest only up, neither cleared, so that the trace never says less than was seen, on either side (security reviews of schema 9, C1 and R8).
CREATE TRIGGER IF NOT EXISTS trade_trails_terms_trace BEFORE UPDATE ON trade_trails
WHEN (OLD.terms_changed_at IS NOT NULL AND NEW.terms_changed_at IS NOT OLD.terms_changed_at)
  OR (OLD.terms_changed_at IS NULL AND NEW.terms_changed_at IS NOT NULL AND NEW.terms_changed_at IS NOT NEW.read_at)
  OR (OLD.terms_changed_premium_low IS NOT NULL AND (NEW.terms_changed_premium_low IS NULL OR NEW.terms_changed_premium_low > OLD.terms_changed_premium_low))
  OR (OLD.terms_changed_premium_high IS NOT NULL AND (NEW.terms_changed_premium_high IS NULL OR NEW.terms_changed_premium_high < OLD.terms_changed_premium_high))
BEGIN
  SELECT RAISE(ABORT, 'the trace of terms shown otherwise is kept');
END;
