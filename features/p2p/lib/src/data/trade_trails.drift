-- The rules of the trades' terms and trails that the database keeps itself (schema 4, #87): see `StoredTradeTerms` and `StoredTradeTrails` in `p2p_tables.dart`.
-- What a trigger cannot say, that the position of a trail moves only along the edges of the trade, is `TradeTrailRecord.whyNotReplace`'s, which the repository asks before every write.
import 'p2p_tables.dart';

-- The terms of a trade are never deleted.
CREATE TRIGGER IF NOT EXISTS trade_terms_never_deleted BEFORE DELETE ON trade_terms
BEGIN
  SELECT RAISE(ABORT, 'the terms of a trade are kept');
END;

-- The terms of a trade are set once: any update is refused.
CREATE TRIGGER IF NOT EXISTS trade_terms_set_once BEFORE UPDATE ON trade_terms
BEGIN
  SELECT RAISE(ABORT, 'the terms of a trade are set once');
END;

-- The terms of a trade are written once: a second insert, `INSERT OR REPLACE` included (whose delete fires no trigger while recursive triggers are off), writes nothing.
CREATE TRIGGER IF NOT EXISTS trade_terms_inserted_once BEFORE INSERT ON trade_terms
WHEN EXISTS (SELECT 1 FROM trade_terms WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The terms belong to the open trade of their robot: the same order, coordinator, network and role.
CREATE TRIGGER IF NOT EXISTS trade_terms_of_their_trade BEFORE INSERT ON trade_terms
WHEN NOT EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index AND network = NEW.network AND coordinator_alias = NEW.coordinator_alias AND order_id = NEW.order_id AND role = NEW.role AND closed_at IS NULL)
BEGIN
  SELECT RAISE(ABORT, 'terms of no open trade');
END;

-- The trail of a trade is never deleted.
CREATE TRIGGER IF NOT EXISTS trade_trails_never_deleted BEFORE DELETE ON trade_trails
BEGIN
  SELECT RAISE(ABORT, 'the trail of a trade is kept');
END;

-- The trail of a trade is written once, then only updated: a second insert, `INSERT OR REPLACE` included, writes nothing.
CREATE TRIGGER IF NOT EXISTS trade_trails_inserted_once BEFORE INSERT ON trade_trails
WHEN EXISTS (SELECT 1 FROM trade_trails WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The trail belongs to the open trade of its robot, whose terms are recorded: the same order, coordinator, network and role.
CREATE TRIGGER IF NOT EXISTS trade_trails_of_their_trade BEFORE INSERT ON trade_trails
WHEN NOT EXISTS (SELECT 1 FROM trades JOIN trade_terms ON trade_terms.key_fingerprint = trades.key_fingerprint AND trade_terms.robot_index = trades.robot_index WHERE trades.key_fingerprint = NEW.key_fingerprint AND trades.robot_index = NEW.robot_index AND trades.network = NEW.network AND trades.coordinator_alias = NEW.coordinator_alias AND trades.order_id = NEW.order_id AND trades.role = NEW.role AND trades.closed_at IS NULL)
BEGIN
  SELECT RAISE(ABORT, 'a trail of no open trade');
END;

-- The trail of a closed trade is never written again: a late write leaves it as it is.
CREATE TRIGGER IF NOT EXISTS trade_trails_closed BEFORE UPDATE ON trade_trails
WHEN EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = OLD.key_fingerprint AND robot_index = OLD.robot_index AND closed_at IS NOT NULL)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- The trail only moves forward: its trade never changes, the version and the read never go back, a breach is never cleared, whether the history is known never changes, a pinned payment hash is never cleared or changed, the pre-take's last read is never cleared or moved back nor its deadline cleared, and an end is never left.
CREATE TRIGGER IF NOT EXISTS trade_trails_forward BEFORE UPDATE ON trade_trails
WHEN NEW.key_fingerprint IS NOT OLD.key_fingerprint
  OR NEW.robot_index IS NOT OLD.robot_index
  OR NEW.network IS NOT OLD.network
  OR NEW.coordinator_alias IS NOT OLD.coordinator_alias
  OR NEW.order_id IS NOT OLD.order_id
  OR NEW.role IS NOT OLD.role
  OR NEW.version < OLD.version
  OR NEW.read_at < OLD.read_at
  OR NEW.breached < OLD.breached
  OR NEW.history_unknown IS NOT OLD.history_unknown
  OR (OLD.bond_hash IS NOT NULL AND NEW.bond_hash IS NOT OLD.bond_hash)
  OR (OLD.escrow_hash IS NOT NULL AND NEW.escrow_hash IS NOT OLD.escrow_hash)
  OR (OLD.bond_step_seen_at IS NOT NULL AND (NEW.bond_step_seen_at IS NULL OR NEW.bond_step_seen_at < OLD.bond_step_seen_at))
  OR (OLD.bond_step_deadline IS NOT NULL AND NEW.bond_step_deadline IS NULL)
  OR (OLD.position IN ('succeeded', 'makerLostDispute', 'takerLostDispute', 'expired', 'cancelled', 'publicAgain', 'notAvailable') AND NEW.position IS NOT OLD.position)
BEGIN
  SELECT RAISE(ABORT, 'a trail only moves forward');
END;
