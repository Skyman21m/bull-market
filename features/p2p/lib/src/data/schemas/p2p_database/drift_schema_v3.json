        "name": "trades_set_once",
        "sql": "CREATE TRIGGER IF NOT EXISTS trades_set_once BEFORE UPDATE ON trades\nWHEN OLD.closed_at IS NOT NULL\n  OR (OLD.confirmed_at IS NOT NULL AND NEW.confirmed_at IS NOT OLD.confirmed_at)\n  OR NEW.network IS NOT OLD.network\n  OR NEW.key_fingerprint IS NOT OLD.key_fingerprint\n  OR NEW.robot_index IS NOT OLD.robot_index\n  OR NEW.coordinator_alias IS NOT OLD.coordinator_alias\n  OR NEW.coordinator_onion IS NOT OLD.coordinator_onion\n  OR NEW.order_id IS NOT OLD.order_id\n  OR NEW.role IS NOT OLD.role\n  OR NEW.origin IS NOT OLD.origin\n  OR NEW.taken_at IS NOT OLD.taken_at\nBEGIN\n  SELECT RAISE(ABORT, 'a trade record only gains its times');\nEND;"
