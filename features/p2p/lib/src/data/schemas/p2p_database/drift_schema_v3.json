          "sql": "CREATE TABLE IF NOT EXISTS \"trades\" (\"network\" TEXT NOT NULL, \"key_fingerprint\" TEXT NOT NULL, \"robot_index\" INTEGER NOT NULL, \"coordinator_alias\" TEXT NOT NULL, \"coordinator_onion\" TEXT NOT NULL, \"order_id\" INTEGER NOT NULL, \"role\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"taken_at\" INTEGER NOT NULL, \"confirmed_at\" INTEGER NULL, \"closed_at\" INTEGER NULL, PRIMARY KEY (\"key_fingerprint\", \"robot_index\"), CHECK (network IN ('mainnet', 'testnet')), CHECK (length(key_fingerprint) = 64 AND key_fingerprint NOT GLOB '*[^0-9a-f]*'), CHECK (robot_index BETWEEN 0 AND 2147483647), CHECK (length(coordinator_alias) > 0), CHECK (length(coordinator_onion) > 0), CHECK (order_id > 0), CHECK (role IN ('buyer', 'seller')), CHECK (origin IN ('takenHere', 'recovered')), CHECK (origin = 'takenHere' OR confirmed_at IS NOT NULL), CHECK (taken_at BETWEEN 0 AND 8640000000000000), CHECK (confirmed_at IS NULL OR confirmed_at BETWEEN 0 AND 8640000000000000), CHECK (closed_at IS NULL OR closed_at BETWEEN 0 AND 8640000000000000), FOREIGN KEY (key_fingerprint, robot_index, network) REFERENCES robot_bindings (key_fingerprint, robot_index, network));"
