-- The rules of the peer's keys pinned for the trades' chats that the database keeps itself (schema 6, #139): see `StoredTradeChatPins` in `p2p_tables.dart`.
import 'p2p_tables.dart';

-- A pin is never deleted: it is how a restart knows the key it pinned.
CREATE TRIGGER IF NOT EXISTS trade_chat_pins_never_deleted BEFORE DELETE ON trade_chat_pins
BEGIN
  SELECT RAISE(ABORT, 'the pinned key of a trade is kept');
END;

-- A pin never changes: another key is a breach, never a new pin.
CREATE TRIGGER IF NOT EXISTS trade_chat_pins_never_changed BEFORE UPDATE ON trade_chat_pins
BEGIN
  SELECT RAISE(ABORT, 'the pinned key of a trade never changes');
END;

-- A pin is written once per trade: a second insert, `INSERT OR REPLACE` included (whose delete fires no trigger while recursive triggers are off), writes nothing.
CREATE TRIGGER IF NOT EXISTS trade_chat_pins_inserted_once BEFORE INSERT ON trade_chat_pins
WHEN EXISTS (SELECT 1 FROM trade_chat_pins WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index)
BEGIN
  SELECT RAISE(IGNORE);
END;

-- A pin belongs to an open trade: a closed trade has no chat to pin.
CREATE TRIGGER IF NOT EXISTS trade_chat_pins_of_their_trade BEFORE INSERT ON trade_chat_pins
WHEN NOT EXISTS (SELECT 1 FROM trades WHERE key_fingerprint = NEW.key_fingerprint AND robot_index = NEW.robot_index AND closed_at IS NULL)
BEGIN
  SELECT RAISE(ABORT, 'a pin of no open trade');
END;
